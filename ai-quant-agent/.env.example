# Tushare 配置
TUSHARE_TOKEN=your_tushare_token_here
# Tushare 每分钟请求上限(免费档一般200, 更高积分可调大; 默认200)
TUSHARE_RATE_LIMIT=200

# DeepSeek 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# ★ LLM 三闸门预算（元）。**首次创建 data/llm_budget.json 时作为初始值**；
#   已有台账则沿用台账里的值（改这里不生效，请改台账文件或调用 llm_metering.set_limits()）。
#   实测参考：2026-09-23 当天 189 次调用花掉 3.0 元（≈1.6 分/次，其中 187 次带思维链）；
#   原默认 per_day=3.0 不够一次完整扫描 → 预算打满即"Agent 全部降级为按规则概率保留"。
# LLM_BUDGET_PER_TASK_CNY=5
# LLM_BUDGET_PER_DAY_CNY=10
# LLM_BUDGET_TOTAL_CNY=50
# ★ 精筛漏斗口径（用户口径 2026-09-23：**每个板块前 10 都进深度分析**）
#   L1：按行业分组批量粗筛，每行业最多保留 N 只（候选）
# AGENT_L1_PER_INDUSTRY=10
#   L2：全局 Top-N（按 up_probability）+ 形态规则保送
# AGENT_L2_DEEP_TOP_N=50
#   L2：每行业保底进深度的只数（0=只走全局 Top-N，小板块头部会被大板块挤掉）
# AGENT_L2_PER_INDUSTRY_FLOOR=10
#   L2：总量上限（**只裁"每行业保底"**；全局 Top-N 与形态规则保送不裁）
# AGENT_L2_MAX_TOTAL=200
#   政策解读只对频次最高的 N 个行业做
# AGENT_POLICY_MAX_SECTORS=5
# ★ 思考模式：官方默认开启，reasoning_tokens 按**输出价**计费（输出单价是输入未命中价的 4 倍），
#   实测同问题约为关闭时的 3.7 倍成本。用户口径是"deepseek-flash 就用思考模式"（默认 True），
#   若预算吃紧可临时关闭或降低强度：DEEPSEEK_THINKING=false / DEEPSEEK_REASONING_EFFORT=low
# DEEPSEEK_THINKING=true
# DEEPSEEK_REASONING_EFFORT=high

# Tavily 配置（消息面验证：防烟雾弹/防利好出货；含政策兜底抓取）
TAVILY_API_KEY=your_tavily_api_key_here
# 直连 api.tavily.com 偶发 SSLError(SSLZeroReturnError)=链路中断，重试多可成功；
# 若失败频繁，填本地/公司代理走更稳出口（留空则沿用系统 HTTPS_PROXY）
# TAVILY_PROXY=http://127.0.0.1:7890
# 单次请求读取超时 / 每轮尝试次数（含首次，指数退避重试）
# TAVILY_TIMEOUT=30
# TAVILY_MAX_ATTEMPTS=3
# ★ 消息面必需（默认 true）：失败**不静默略过** —— 跨轮重试 → 欠账入队补做 → 开 ERROR 工单
#   给进化大脑（含复现命令与候选修复动作）。改为 false 才退回旧的"失败即无消息面"。
# TAVILY_REQUIRED=true
# 跨轮重试：最多几轮 × 每轮次数（瞬时抖动常持续数秒，一轮打完就放弃太早）/ 轮间隔秒 / 总时限秒
# TAVILY_ROUNDS=3
# TAVILY_ROUND_GAP_S=5
# TAVILY_DEADLINE_S=60
# 欠账队列：上限条数 / 每轮扫描收尾最多补做几条
# TAVILY_PENDING_MAX=200
# TAVILY_DRAIN_LIMIT=3
# 消息面缓存有效期（秒，默认 6 小时）：同 query 直接命中，省额度且让补做结果被复用
# TAVILY_CACHE_TTL_S=21600
# 连续失败 N 次后熔断降温 M 秒（只降温不放弃：期间失败的 query 仍记入欠账）
# TAVILY_FAIL_THRESHOLD=3
# TAVILY_CIRCUIT_COOLDOWN=60
# 自建网关/镜像端点（一般留空）
# TAVILY_BASE_URL=

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=quant_user
DB_PASSWORD=quant_pass_2024
DB_NAME=quant_db

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
